meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/user/profile
  body: json
  auth: none
}

headers {
  x: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "John Updated",
    "email": "john@example.com",
    "phone": "01099998888",
    "address": [
      {
        "street": "20 Dokki St",
        "city": "Giza",
        "postalCode": "12345"
      }
    ],
    "gender": "male"
  }
}

docs {
  Updates profile details of the currently authenticated user.
}
