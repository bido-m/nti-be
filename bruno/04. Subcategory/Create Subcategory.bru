meta {
  name: Create Subcategory
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/subcategory
  body: json
  auth: none
}

headers {
  x: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Smartphones",
    "category_id": "{{categoryId}}"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data._id) {
    bru.setEnvVar("subcategoryId", res.body.data._id);
  }
}

docs {
  Creates a subcategory under a specified category.
}
