meta {
  name: Update Order Status
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/order/{{orderId}}/status
  body: json
  auth: none
}

headers {
  x: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "completed"
  }
}

docs {
  Updates order status (allowed values: pending, completed, canceled).
}
