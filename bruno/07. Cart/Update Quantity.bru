meta {
  name: Update Cart Quantity
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/cart/quantity
  body: json
  auth: none
}

headers {
  x: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "product_id": "{{productId}}",
    "quantity": 3
  }
}

docs {
  Updates product quantity in cart.
}
